# Senha única de acesso ao dita. Defina a sua aqui antes do primeiro boot.
# A Ponte lê este arquivo sozinha; variáveis já definidas no shell vencem.
# Se ficar vazia, uma senha é gerada e salva em ~/.dita/credentials.json.
DITA_PASSWORD=

# Segredo do cookie de sessão. Se omitido, também é gerado e persistido.
DITA_SESSION_SECRET=

# Porta da Ponte.
DITA_PORT=8787

# Pasta raiz dos projetos que o seletor navega.
DITA_ROOT=C:\Users\Matheus\Documents\Projetos

# URL do servidor OpenCode usado pela Ponte.
OPENCODE_URL=http://127.0.0.1:4096

# Senha Basic do servidor OpenCode (usuário é sempre "opencode").
OPENCODE_PASSWORD=

# false = a Ponte não sobe o `opencode serve`, só usa um já existente.
DITA_MANAGE_OPENCODE=true

# Diretório de estado (estado mínimo: sessão atual, push, aprovações).
DITA_DATA_DIR=C:\Users\Matheus\.dita
